    <slider x="15" step="1.0" y="547" max="20.0" width="174" display="sheep-reproduce" height="50" min="1.0" direction="Horizontal" default="4.0" variable="sheep-reproduce" units="%"></slider>
    <slider x="215" step="1" y="217" max="250" width="175" display="initial-number-wolves" height="50" min="0" direction="Horizontal" default="50.0" variable="initial-number-wolves"></slider>
