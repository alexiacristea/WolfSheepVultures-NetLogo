<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[; Proiect extins NetLogo: Sheep-Wolves-Vultures cu anotimp și boală la lupi
; Acest model este o extensie a "Wolf Sheep Predation" (Uri Wilensky, 1997), care include:
; - Un al treilea prădător: vultures
; - Boala la lupi
; - Un anotimp de iarnă care influențează iarba
; Modelul poate fi folosit pentru a analiza stabilitatea unui ecosistem extins.

globals [ max-sheep winter? ]  ; Am adăugat variabila winter?, care indică dacă este iarnă în simulare. O folosesc mai jos ca să încetinesc regenerarea ierbii în timpul iernii


breed [ sheep a-sheep ]
breed [ wolves wolf ]
breed [ vultures vulture ]  ; Am adăugat o nouă rasă numită vultures, care reprezintă vulturii. Ei sunt un al treilea prădător și mănâncă lupi slabi sau bolnavi.

turtles-own [ energy sick? ] ; Am adăugat variabila sick?, care stochează starea de sănătate a lupului. Dacă e true, lupul este bolnav și nu mai poate vâna.

patches-own [ countdown ]

to setup
  clear-all
  ifelse netlogo-web? [ set max-sheep 10000 ] [ set max-sheep 30000 ]

  set winter? false  ; La începutul simulării nu e iarnă. Sezonul se schimbă automat la fiecare 100 de ticks.

  ifelse grass-enabled? [  ; iarba exista atat in "sheep-wolves-grass", cat si in "sheep-wolves-vultures"
    ask patches [
      set pcolor one-of [ green brown ]
      ifelse pcolor = green
        [ set countdown grass-regrowth-time ]
      [ set countdown random grass-regrowth-time ]
    ]
  ]
  [
    ask patches [ set pcolor green ]
  ]

  create-sheep initial-number-sheep
  [
    set shape  "sheep"
    set color white
    set size 1.5
    set label-color blue - 2
    set energy random (2 * sheep-gain-from-food)
    setxy random-xcor random-ycor
    set sick? false  ; Fiecare animal este creat sănătos. Deci sick? este setat pe false la început.
  ]

  create-wolves initial-number-wolves
  [
    set shape "wolf"
    set color black
    set size 2
    set energy random (2 * wolf-gain-from-food)
    setxy random-xcor random-ycor
    set sick? false  ; Fiecare animal este creat sănătos. Deci sick? este setat pe false la început.
  ]

  if model-version = "sheep-wolves-vultures" [
    create-vultures initial-number-vultures [ ; Am creat vulturii, plasându-i aleator în spațiu. Ei vor începe să se miște și să caute prada.
      set shape "airplane"
      set color yellow
      set size 3
      set energy random 20 + random 20
      setxy random-xcor random-ycor
      set sick? false  ; Fiecare animal este creat sănătos. Deci sick? este setat pe false la început.
    ]
  ]

  display-labels
  reset-ticks
end

to go

  if not any? turtles [ stop ]
  if not any? wolves and count sheep > max-sheep [ user-message "The sheep have inherited the earth" stop ]

  update-season  ; Schimbă variabila winter? la fiecare 100 de ticks. Iarna, regenerarea ierbii e mai lentă.

  ask sheep [
    move

    if grass-enabled? [  ; oile depind de iarba in ambele variante cu iarba
      set energy energy - 1
      eat-grass
      death
    ]
    reproduce-sheep
  ]

  ask wolves [
    move

    ifelse not sick? [ ; Dacă un lup e bolnav (sick? = true), nu poate vâna oi. Asta îl face vulnerabil și îl poate omorî foamea sau vulturii.
      set energy energy - 1
      eat-sheep
    ] [
      set energy energy - 1.5 ; pierd mai multă energie dacă sunt bolnav
    ]

    death ; Lupii mor daca raman fara energie
    if not sick? [ reproduce-wolves ] ; doar lupii sanatosi se reproduc
    maybe-get-sick  ; Fiecare lup sănătos are o șansă să se îmbolnăvească, în funcție de sliderul sickness-chance

    ifelse sick? [ set color red ] ; Afișează cu roșu dacă e bolnav
                 [ set color black ] ; Altfel negru
  ]

  if model-version = "sheep-wolves-vultures" [
    ask vultures [ ; Vulturii se mișcă, pierd energie la fiecare pas și mănâncă lupi slabi sau bolnavi.
      move
      set energy energy - 0.05 ; Vulturii pierd putina energie: rezista mult fara hrana, ca niste gropari
      death ; Mor dacă rămân fără energie
      eat-wolf ; Atacă lupi slabi sau bolnavi
      reproduce-vultures ; Se pot reproduce
    ]
  ]

  if grass-enabled? [ ask patches [ grow-grass ] ]

  tick
  display-labels
end

to move  ; turtle procedure
  rt random 50
  lt random 50
  fd 1
end

to eat-grass  ; Oile mananca iarba, iar iarba mancata devine maro
  if pcolor = green [
    set pcolor brown
    set energy energy + sheep-gain-from-food  ; Oile capata energie mancand iarba
  ]
end

to reproduce-sheep
  if random-float 100 < sheep-reproduce [
    set energy (energy / 2)
    hatch 1 [ rt random-float 360 fd 1 set sick? false ] ; Toți puii se nasc sănătoși.
  ]
end

to reproduce-wolves
  if random-float 100 < wolf-reproduce [
    set energy (energy / 2)
    hatch 1 [ rt random-float 360 fd 1 set sick? false ] ; Toți puii se nasc sănătoși.
  ]
end

to reproduce-vultures
  if random-float 100 < vulture-reproduce [
    set energy (energy / 2)
    hatch 1 [ rt random-float 360 fd 1 set sick? false ] ; Toți puii se nasc sănătoși.
  ]
end

to eat-sheep  ; Lupul omoară o oaie și primește energie
  let prey one-of sheep-here                    ; Alege o oaie la intamplare
  if prey != nobody  [
    ask prey [ die ]
    set energy energy + wolf-gain-from-food     ; Castiga energie mancand
  ]
end

to eat-wolf  ; Vulturul omoară un lup slab sau bolnav, cu șansă de 60%
  let target one-of wolves-here with [ sick? or energy < 5 ]
  if target != nobody and random-float 100 < 60 [  ; Doar 60% șansă să atace
    ask target [ die ] ; Vulturul omoara lupul
    set energy energy + vulture-gain-from-food  ; Vulturul primește energie în funcție de sliderul din interfata
  ]
end

to death
  if energy <= 0 [ die ] ; Daca energia scade sub 0, moare
end

to grow-grass
  if pcolor = brown [  ; doar iarba mancata (maro) are nevoie sa creasca la loc
    ifelse countdown <= 0 [
      set pcolor green
      set countdown grass-regrowth-time
    ] [
      ifelse winter?
        [ set countdown countdown - 0.75 ]  ; iarna, iarba creste mai lent
        [ set countdown countdown - 1 ]    ; vara, iarba creste normal
    ]
  ]
end

to-report grass
  ifelse grass-enabled?
    [ report patches with [ pcolor = green ] ]
    [ report no-patches ]  ; multime goala, ca "count grass" sa dea 0, nu eroare
end

to display-labels
  ask turtles [ set label "" ]
  if show-energy? [
    ask wolves [ set label round energy ]
    ask sheep [ set label round energy ]
    if model-version = "sheep-wolves-vultures" [
      ; La fel ca la lupi și oi, am activat afișarea energiei și pentru vulturi,
      ; ca să pot urmări mai ușor cât de bine se descurcă.
      ask vultures [ set label round energy ]
    ]
  ]
end

to update-season
  if ticks > 0 and ticks mod 100 = 0 [ set winter? not winter? ] ; La fiecare 100 ticks schimb anotimpul (fara tick 0, ca simularea sa inceapa vara)
end

to maybe-get-sick
  if not sick? and random-float 100 < sickness-chance [ set sick? true ] ; Un lup sănătos se îmbolnăvește cu o probabilitate dată
end

to-report grass-enabled?  ; iarba exista in "sheep-wolves-grass" si "sheep-wolves-vultures"
  report model-version != "sheep-wolves"
end]]></code>
